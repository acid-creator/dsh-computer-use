{
  "name": "@acid-creator/dsh-computer-use",
  "version": "1.0.0",
  "description": "为 DeepSeek Harness 增加 Codex 风格的电脑操作（computer use）：通过 Cua Driver 控制桌面，通过 Playwright MCP 自动化 Chromium 浏览器。",
  "author": "acid-creator",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "computer-use",
    "cua-driver",
    "playwright",
    "mcp",
    "browser-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acid-creator/dsh-computer-use.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "tools", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
